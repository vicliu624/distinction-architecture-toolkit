{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Distinction Architecture Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/examples/sample-project"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
