{
  "name": "explicit-architecture-vscode",
  "displayName": "Explicit Architecture",
  "description": "Architecture interpretation, responsibility analysis, and legacy surface inventory.",
  "version": "0.1.0",
  "publisher": "vicliu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:explicitArchitecture.explainSelectedCode",
    "onCommand:explicitArchitecture.findResponsibilityOverload",
    "onCommand:explicitArchitecture.generateSurfaceInventory"
  ],
  "contributes": {
    "commands": [
      {
        "command": "explicitArchitecture.explainSelectedCode",
        "title": "Explicit Architecture: Explain Selected Code"
      },
      {
        "command": "explicitArchitecture.findResponsibilityOverload",
        "title": "Explicit Architecture: Find Responsibility Overload"
      },
      {
        "command": "explicitArchitecture.generateSurfaceInventory",
        "title": "Explicit Architecture: Generate Surface Inventory"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "vsce package"
  },
  "dependencies": {
    "@explicit-architecture/core": "0.1.0",
    "@explicit-architecture/analyzer": "0.1.0",
    "@explicit-architecture/report-model": "0.1.0",
    "@explicit-architecture/rules": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "^2.15.0"
  }
}
